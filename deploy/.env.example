# ---- required ----
NODE_ENV=production
DOMAIN=yourdomain.in                       # used by Caddy for HTTPS
SITE_URL=https://yourdomain.in             # canonical URL, sitemap, Open Graph (no trailing slash)
TRUST_PROXY=1                              # behind Caddy / Render / Railway proxy
# First admin account is created on first start only. After that, REMOVE ADMIN_PASSWORD
# from this file and manage accounts with: node scripts/admin-user.js reset <username>
ADMIN_USERNAME=akadmin
ADMIN_PASSWORD=                            # >= 12 characters, unique
OTP_PEPPER=                                # 64 random hex chars: openssl rand -hex 32
WEBHOOK_SECRET=                            # random string for delivery-report webhooks: openssl rand -hex 24

# ---- optional: backups ----
BACKUP_RETENTION=14                        # daily backups kept in /data/backups

# ---- SMS (MSG91, DLT) — leave blank to keep SMS disabled ----
MSG91_AUTHKEY=
ADMIN_OTP_MOBILE=                          # admin mobile that receives campaign OTPs
OTP_TEMPLATE_ID=                           # MSG91 flow/template ID for the OTP message
OTP_DLT_TEMPLATE_ID=                       # DLT template ID registered for that OTP message
OTP_SENDER_ID=                             # 6-letter DLT header, e.g. AKDGPR

# ---- WhatsApp Business Cloud API — leave blank to keep disabled ----
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=

# ---- Meta direct publishing — leave blank to keep disabled (manual sharing still works) ----
META_PAGE_ID=
IG_USER_ID=
META_PAGE_TOKEN=
PUBLIC_BASE_URL=https://yourdomain.in

# ---- only if you open the standalone HTML file against this server ----
# CORS_ORIGINS=null
